# Copy to .env and fill in. Real environment variables override this file.
# The app runs without any keys: typed turns work, replies are templates, voice is off.

# --- API keys: paste yours here ---------------------------------------------
SARVAM_API_KEY=            # https://dashboard.sarvam.ai  (speech to text + text to speech)
LLM_API_KEY=               # https://console.anthropic.com (Claude: extract, route, phrase)

# --- Settings ----------------------------------------------------------------
LLM_PROVIDER=anthropic     # anthropic | none (none = template replies only)
LLM_MODEL=claude-opus-5-5
SARVAM_SPEAKER=ritu        # any bulbul:v3 voice, lowercase; empty = Sarvam default
DATABASE_URL=sqlite:///local.db   # Supabase: postgresql://USER:PASSWORD@HOST:5432/postgres
OPS_PASSCODE=change-me     # operator view at /ops
SESSION_SECRET=change-me-to-a-long-random-string
NOMINATIM_USER_AGENT=agri-decision-agent/0.1 (contact: you@example.com)
SCHEDULE_HOURS=3
